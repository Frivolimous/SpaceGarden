<Project Sdk="Godot.NET.Sdk/4.7.2">
  <!-- Presentation, input and the widget window only. The garden's rules live in src/Core. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>SpaceGarden</RootNamespace>
    <!-- Optimised even in the debug build the game runs from the project (as src/Core is), so the per-frame drawing
         work costs what it will in an export. -->
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\Core\SpaceGarden.Core.csproj" />
    <Using Include="SpaceGarden.Core" />
  </ItemGroup>
</Project>
