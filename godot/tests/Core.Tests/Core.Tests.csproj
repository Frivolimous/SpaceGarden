<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless tests of the garden's rules (src/Core): no Godot. Run with "dotnet test" from godot/. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SpaceGarden.Core.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\SpaceGarden.Core.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
